# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of the Next.js frontend (used for CORS and links in e-mails)
WEB_URL=http://localhost:3000

# ---------- Database ----------
# MongoDB must run as a replica set (a single node is enough) so that transactions work.
# Use the same string in MongoDB Compass to view the data.
MONGODB_URI=mongodb://127.0.0.1:27017/admitra?replicaSet=rs0

# ---------- Security ----------
# Use a long random value (at least 32 characters) in production.
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-of-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# ---------- E-mail (SMTP) ----------
# Leave SMTP_HOST empty in development: e-mails are then printed in the backend console.
# With Mailpit running locally: SMTP_HOST=127.0.0.1 and SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="ADMITRA <no-reply@admitra.local>"

# ---------- Files ----------
# Where uploaded documents, logos and profile pictures are kept:
#   local -> a private folder on this server (STORAGE_DIR), the default
#   s3    -> an Amazon S3 bucket (needs an AWS account with a payment card)
#   r2    -> a Cloudflare R2 bucket (needs a Cloudflare account with a payment card; 10 GB free each month)
# Keep the bucket private: files are always served through the API after a permission check.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
STORAGE_BUCKET=
# s3 only, e.g. ap-south-1 (Mumbai) or me-central-1 (UAE)
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# r2 only: the account id from the Cloudflare dashboard (or the full endpoint in STORAGE_ENDPOINT)
R2_ACCOUNT_ID=
STORAGE_ENDPOINT=

# ---------- AI assistant (Mitra) ----------
# Provider: gemini | openai | anthropic | openai-compatible | none
# Only these values change when you move to another provider; the assistant works the same.
#   gemini            -> key from Google AI Studio (free tier available)
#   openai            -> key from platform.openai.com
#   anthropic         -> key from console.anthropic.com (Claude)
#   openai-compatible -> any service with an OpenAI-style API (set AI_BASE_URL, e.g. Groq, OpenRouter, Ollama)
AI_PROVIDER=gemini
AI_API_KEY=
# Leave empty for the provider's default model
AI_MODEL=
AI_BASE_URL=
AI_DAILY_LIMIT=200
AI_BRIEFING_HOUR=8

# ---------- Seed (npm run seed) ----------
SEED_SUPERADMIN_NAME=Platform Administrator
SEED_SUPERADMIN_EMAIL=admin@admitra.local
SEED_SUPERADMIN_PASSWORD=Admin@12345
